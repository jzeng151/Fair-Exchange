          },
          "title": "Peer Examples",
          "type": "array"
        },
        "seq": {
          "description": "Increasing within one turn",
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "answer",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "type",
        "insights",
        "peer_examples",
        "evidence"
      ],
      "title": "AnswerEvent",
      "type": "object"
    },
    "AutoCloseRequest": {
      "additionalProperties": false,
