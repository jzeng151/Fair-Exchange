  "additionalProperties": false,
  "description": "Requests, actions and events between the chat API and the agent. Generated from agent/src/fex/conversation/contract.py; do not edit by hand.",
  "properties": {
    "event": {
      "discriminator": {
        "mapping": {
          "actions": "#/$defs/ActionsEvent",
          "answer": "#/$defs/AnswerEvent",
          "claim": "#/$defs/ClaimEvent",
          "done": "#/$defs/DoneEvent",
          "error": "#/$defs/ErrorEvent",
          "record_saved": "#/$defs/RecordSavedEvent",
          "step": "#/$defs/StepEvent",
          "text": "#/$defs/TextEvent"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TextEvent"
        },
        {
          "$ref": "#/$defs/ClaimEvent"
        },
        {
          "$ref": "#/$defs/AnswerEvent"
        },
        {
          "$ref": "#/$defs/StepEvent"
        },
        {
          "$ref": "#/$defs/ActionsEvent"
        },
        {
          "$ref": "#/$defs/RecordSavedEvent"
        },
        {
          "$ref": "#/$defs/ErrorEvent"
        },
        {
          "$ref": "#/$defs/DoneEvent"
        }
      ],
      "title": "Event"
    },
    "request": {
      "discriminator": {
        "mapping": {
          "action": "#/$defs/ActionRequest",
          "auto_close": "#/$defs/AutoCloseRequest",
          "message": "#/$defs/MessageRequest",
          "resume": "#/$defs/ResumeRequest",
          "start": "#/$defs/StartRequest"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/StartRequest"
        },
        {
          "$ref": "#/$defs/MessageRequest"
        },
        {
          "$ref": "#/$defs/ActionRequest"
        },
        {
          "$ref": "#/$defs/ResumeRequest"
        },
        {
          "$ref": "#/$defs/AutoCloseRequest"
        }
      ],
      "title": "Request"
    },
    "resume": {
      "$ref": "#/$defs/ResumeResponse"
    }
  },
  "required": [
    "request",
    "event",
    "resume"
  ],
  "title": "ConversationContract",
  "type": "object"
}
