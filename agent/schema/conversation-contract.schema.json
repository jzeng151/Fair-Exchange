          "title": "Peer Examples",
          "type": "array"
        }
      },
      "required": [
        "insights",
        "peer_examples",
        "evidence"
      ],
      "title": "Answer",
      "type": "object"
    },
    "AnswerEvent": {
      "additionalProperties": false,
      "properties": {
