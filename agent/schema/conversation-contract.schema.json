{
  "$defs": {
    "ActionEntry": {
      "additionalProperties": false,
      "properties": {
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "name": {
          "enum": [
            "confirm_playback",
            "correct_playback",
            "reopen_playback",
            "retry_answer",
            "set_consent",
            "set_feedback",
            "end"
          ],
          "title": "Name",
          "type": "string"
        },
        "role": {
          "const": "action",
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "name",
        "args",
        "at"
      ],
      "title": "ActionEntry",
      "type": "object"
    },
    "ActionRequest": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "discriminator": {
            "mapping": {
              "confirm_playback": "#/$defs/ConfirmPlayback",
              "correct_playback": "#/$defs/CorrectPlayback",
              "end": "#/$defs/End",
              "reopen_playback": "#/$defs/ReopenPlayback",
              "retry_answer": "#/$defs/RetryAnswer",
              "set_consent": "#/$defs/SetConsent",
              "set_feedback": "#/$defs/SetFeedback"
            },
            "propertyName": "name"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/ConfirmPlayback"
            },
            {
              "$ref": "#/$defs/CorrectPlayback"
            },
            {
              "$ref": "#/$defs/ReopenPlayback"
            },
            {
              "$ref": "#/$defs/RetryAnswer"
            },
            {
              "$ref": "#/$defs/SetConsent"
            },
            {
              "$ref": "#/$defs/SetFeedback"
            },
            {
              "$ref": "#/$defs/End"
            }
          ],
          "title": "Action"
        },
        "conversationId": {
          "description": "Set by the chat API",
          "minLength": 1,
          "title": "Conversationid",
          "type": "string"
        },
        "kind": {
          "const": "action",
          "title": "Kind",
          "type": "string"
        },
        "producerId": {
          "description": "Set by the chat API from the identity",
          "minLength": 1,
          "title": "Producerid",
          "type": "string"
        }
      },
      "required": [
        "producerId",
        "conversationId",
        "kind",
        "action"
      ],
      "title": "ActionRequest",
      "type": "object"
    },
    "ActionsEvent": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "items": {
            "enum": [
              "confirm_playback",
              "correct_playback",
              "reopen_playback",
              "retry_answer",
              "set_consent",
              "set_feedback",
              "end"
            ],
            "type": "string"
          },
          "title": "Allowed",
          "type": "array"
        },
        "language": {
          "title": "Language",
          "type": "string"
        },
        "seq": {
          "description": "Increasing within one turn",
          "minimum": 1,
          "title": "Seq",
          "type": "integer"
        },
        "type": {
          "const": "actions",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "seq",
        "type",
        "allowed",
        "language"
      ],
      "title": "ActionsEvent",
      "type": "object"
    },
    "Answer": {
      "additionalProperties": false,
