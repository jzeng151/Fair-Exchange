{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "Where a claim comes from. Every insight and peer example must carry one.",
      "properties": {
        "period": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Time period of the data, if any",
          "title": "Period"
        },
        "source": {
          "description": "Dataset, record or document the fact came from",
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "standard_clause": {
          "description": "Related APS/FPS clause, e.g. 'APS 3.2.1'",
          "minLength": 1,
          "title": "Standard Clause",
          "type": "string"
        },
        "strength": {
          "default": "exact",
          "description": "How well the evidence matches this producer's area",
          "enum": [
            "exact",
            "nearest",
            "limited"
          ],
          "title": "Strength",
          "type": "string"
        }
      },
      "required": [
        "source",
        "standard_clause"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "description": "One insight or peer example given to the producer, with its citation.",
      "properties": {
        "citation": {
          "$ref": "#/$defs/Citation"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "citation"
      ],
      "title": "Claim",
      "type": "object"
    },
    "CompletedRecord": {
      "additionalProperties": false,
      "description": "A conversation the producer agreed to save.",
      "if": {
        "properties": {
          "language": {
            "not": {
              "const": "en"
            }
          }
        },
        "required": [
          "language"
        ]
      },
      "properties": {
        "ai_usage": {
          "description": "Tokens per model for this conversation (AI footprint)",
          "items": {
            "$ref": "#/$defs/ModelUsage"
          },
          "title": "Ai Usage",
          "type": "array"
        },
        "closed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when the conversation closes. Records are reviewable only when set.",
          "title": "Closed At"
        },
        "consent": {
          "$ref": "#/$defs/StoredConsent"
        },
        "consent_history": {
          "description": "The producer's distinct consent choices, in order",
          "items": {
            "$ref": "#/$defs/ConsentChoice"
          },
          "title": "Consent History",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "decision_log": {
          "description": "Recorded decisions for reviewers; absent on declined records",
          "items": {
            "$ref": "#/$defs/DecisionLogEntry"
          },
          "title": "Decision Log",
          "type": "array"
        },
        "earlier_answers": {
          "description": "Answers shown and later replaced, oldest first",
          "items": {
            "$ref": "#/$defs/EarlierAnswer"
          },
          "title": "Earlier Answers",
          "type": "array"
        },
        "entity_type": {
          "description": "e.g. cooperative, smallholder, hired-labor farm, processor",
          "minLength": 1,
          "title": "Entity Type",
          "type": "string"
        },
        "evidence": {
          "description": "limited when the shown answer had no insights or no peer examples",
          "enum": [
            "full",
            "limited"
          ],
          "title": "Evidence",
          "type": "string"
        },
        "feedback": {
          "anyOf": [
            {
              "enum": [
                "yes",
                "somewhat",
                "no"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Was the guidance helpful?",
          "title": "Feedback"
        },
        "insights": {
          "description": "What the data shows, as given to the producer",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Insights",
          "type": "array"
        },
        "language": {
          "description": "ISO 639-1 code of the producer's language, e.g. 'es'",
          "pattern": "^[a-z]{2}$",
          "title": "Language",
          "type": "string"
        },
        "peer_examples": {
          "description": "What others tried, as given to the producer",
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Peer Examples",
          "type": "array"
        },
        "pii_check": {
          "anyOf": [
            {
              "enum": [
                "done",
                "failed",
                "unsupported_language"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Scan result: None until the first scan ran; unsupported_language covers languages other than en and es",
          "title": "Pii Check"
        },
        "pii_entity_types": {
          "description": "Types found across the conversation, in first-seen order",
          "items": {
            "enum": [
              "NAME",
              "PHONE",
              "EMAIL",
              "ADDRESS"
            ],
            "type": "string"
          },
          "title": "Pii Entity Types",
          "type": "array"
        },
        "pii_flag": {
          "default": false,
          "description": "Personal information flagged for human review; never redacted",
          "title": "Pii Flag",
          "type": "boolean"
        },
        "pii_matches": {
          "description": "Every match found across scanned texts; matches are removed if the record turns declined",
          "items": {
            "$ref": "#/$defs/PiiMatch"
          },
          "title": "Pii Matches",
          "type": "array"
        },
        "pii_review": {
          "anyOf": [
            {
              "enum": [
                "confirmed",
                "cleared"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reviewer decision on the PII flag",
          "title": "Pii Review"
        },
        "producer_id": {
          "description": "Set from the session, never from the conversation",
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "review_status": {
          "default": "pending",
          "enum": [
            "pending",
            "reviewed"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "reviewed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed At"
        },
        "reviewed_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewed By"
        },
        "reviewer_summary_english": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reviewer's corrected English summary",
          "title": "Reviewer Summary English"
        },
        "reviewer_summary_original": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reviewer's corrected summary in the producer's language",
          "title": "Reviewer Summary Original"
        },
        "reviewer_tags": {
          "anyOf": [
            {
              "items": {
                "enum": [
                  "climate and weather",
                  "water",
                  "soil and land",
                  "market and price",
                  "labor and migration",
                  "financial and access to capital",
                  "education",
                  "health",
                  "infrastructure",
                  "biodiversity and conservation",
                  "social and community"
                ],
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Reviewer's corrected tags",
          "title": "Reviewer Tags"
        },
        "source": {
          "const": "agent conversation",
          "default": "agent conversation",
          "description": "Never confused with mandatory or compliance reporting data",
          "title": "Source",
          "type": "string"
        },
        "status": {
          "const": "completed",
          "title": "Status",
          "type": "string"
        },
        "summary_english": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "English version; required for non-English conversations",
          "title": "Summary English"
        },
        "summary_original": {
          "description": "The challenge in the producer's own words and language",
          "minLength": 1,
          "title": "Summary Original",
          "type": "string"
        },
        "tags": {
          "description": "Challenge tags from the 11-tag set (the agent's)",
          "items": {
            "enum": [
              "climate and weather",
              "water",
              "soil and land",
              "market and price",
              "labor and migration",
              "financial and access to capital",
              "education",
              "health",
              "infrastructure",
              "biodiversity and conservation",
              "social and community"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        },
        "updated_at": {
          "description": "Time of the latest save",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "description": "Starts at 1; incremented on every save; used for conditional writes",
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "producer_id",
        "created_at",
        "updated_at",
        "version",
        "status",
        "consent",
        "language",
        "entity_type",
        "summary_original",
        "tags",
        "evidence"
      ],
      "then": {
        "properties": {
          "summary_english": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "summary_english"
        ]
      },
      "title": "CompletedRecord",
      "type": "object"
    },
    "ConsentChoice": {
      "additionalProperties": false,
      "description": "One consent choice the producer made (#19, #26). Non-narrative, so allowed on declined records.",
      "properties": {
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "scope": {
          "enum": [
            "internal",
            "internal_and_outward",
            "declined"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "recorded_at"
      ],
      "title": "ConsentChoice",
      "type": "object"
    },
    "DecisionLogEntry": {
      "additionalProperties": false,
      "description": "A recorded decision, containing fixed codes and opaque references only.",
      "properties": {
        "at": {
          "format": "date-time",
          "title": "At",
          "type": "string"
        },
        "code": {
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Code",
          "type": "string"
        },
        "kind": {
          "enum": [
            "step",
            "tool",
            "verifier",
            "pii"
          ],
          "title": "Kind",
          "type": "string"
        },
        "refs": {
          "description": "Step/tool names, item or clause IDs, or PII types; never narrative text",
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        }
      },
      "required": [
        "at",
        "kind",
        "code"
      ],
      "title": "DecisionLogEntry",
      "type": "object"
    },
    "DeclinedConsent": {
      "additionalProperties": false,
      "description": "The producer declined: nothing narrative is stored.",
      "properties": {
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "scope": {
          "const": "declined",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "recorded_at"
      ],
      "title": "DeclinedConsent",
      "type": "object"
    },
    "DeclinedRecord": {
      "additionalProperties": false,
      "description": "The producer declined. Only identifiers, status and time are kept: no narrative content.",
      "properties": {
        "ai_usage": {
          "description": "Tokens per model for this conversation (AI footprint)",
          "items": {
            "$ref": "#/$defs/ModelUsage"
          },
          "title": "Ai Usage",
          "type": "array"
        },
        "closed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Set when the conversation closes. Records are reviewable only when set.",
          "title": "Closed At"
        },
        "consent": {
          "$ref": "#/$defs/DeclinedConsent"
        },
        "consent_history": {
          "description": "The producer's distinct consent choices, in order",
          "items": {
            "$ref": "#/$defs/ConsentChoice"
          },
          "title": "Consent History",
          "type": "array"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "producer_id": {
          "description": "Set from the session, never from the conversation",
          "minLength": 1,
          "title": "Producer Id",
          "type": "string"
        },
        "record_id": {
          "minLength": 1,
          "title": "Record Id",
          "type": "string"
        },
        "source": {
          "const": "agent conversation",
          "default": "agent conversation",
          "description": "Never confused with mandatory or compliance reporting data",
          "title": "Source",
          "type": "string"
        },
        "status": {
          "const": "declined",
          "title": "Status",
          "type": "string"
        },
        "updated_at": {
          "description": "Time of the latest save",
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "version": {
          "description": "Starts at 1; incremented on every save; used for conditional writes",
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        }
      },
      "required": [
        "record_id",
        "producer_id",
        "created_at",
        "updated_at",
        "version",
        "status",
        "consent"
      ],
      "title": "DeclinedRecord",
      "type": "object"
    },
    "EarlierAnswer": {
      "additionalProperties": false,
      "description": "An answer shown to the producer and later replaced (#26).\n\nreopened: the full answer shown before the producer reopened the playback\ninterrupted: only the claims shown before a failed answer was retried",
      "properties": {
        "evidence": {
          "anyOf": [
            {
              "enum": [
                "full",
                "limited"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "null for an interrupted answer, which never finished",
          "title": "Evidence"
        },
        "given_at": {
          "format": "date-time",
          "title": "Given At",
          "type": "string"
        },
        "insights": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Insights",
          "type": "array"
        },
        "peer_examples": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Peer Examples",
          "type": "array"
        },
        "reason": {
          "enum": [
            "reopened",
            "interrupted"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "given_at",
        "reason"
      ],
      "title": "EarlierAnswer",
      "type": "object"
    },
    "ModelUsage": {
      "additionalProperties": false,
      "description": "Tokens one model used in this conversation, for the AI footprint (#26, #29). Non-narrative.",
      "properties": {
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model_id": {
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "model_id",
        "input_tokens",
        "output_tokens"
      ],
      "title": "ModelUsage",
      "type": "object"
    },
    "PiiMatch": {
      "additionalProperties": false,
      "description": "One personal-information match a scan found, kept for human review (issue #20).",
      "properties": {
        "context": {
          "description": "Up to 10 words before and after the match",
          "minLength": 1,
          "title": "Context",
          "type": "string"
        },
        "entity_type": {
          "description": "Only these four types are looked for",
          "enum": [
            "NAME",
            "PHONE",
            "EMAIL",
            "ADDRESS"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "message_at": {
          "description": "When the text containing the match was said",
          "format": "date-time",
          "title": "Message At",
          "type": "string"
        },
        "text": {
          "description": "The matched words; kept for review, never redacted or logged",
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "entity_type",
        "text",
        "context",
        "message_at"
      ],
      "title": "PiiMatch",
      "type": "object"
    },
    "StoredConsent": {
      "additionalProperties": false,
      "description": "The producer agreed to store the conversation. Consent is a scope, not a yes/no:\n\ninternal: stored for Fair Trade USA's own review and trends\ninternal_and_outward: may also be shared outward (e.g. aggregated for partners)",
      "properties": {
        "recorded_at": {
          "format": "date-time",
          "title": "Recorded At",
          "type": "string"
        },
        "scope": {
          "enum": [
            "internal",
            "internal_and_outward"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "recorded_at"
      ],
      "title": "StoredConsent",
      "type": "object"
    }
  },
  "description": "One record per Fair Exchange conversation. Generated from agent/src/fex/models.py; do not edit by hand.",
  "discriminator": {
    "mapping": {
      "completed": "#/$defs/CompletedRecord",
      "declined": "#/$defs/DeclinedRecord"
    },
    "propertyName": "status"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/CompletedRecord"
    },
    {
      "$ref": "#/$defs/DeclinedRecord"
    }
  ],
  "title": "ConversationRecord"
}
