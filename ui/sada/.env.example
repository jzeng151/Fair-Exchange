export AWS_DEFAULT_REGION="us-west-2"
# Only needed if USE_BEDROCK=1 (otherwise the chat runs fully mocked):
export AWS_ACCESS_KEY_ID=""
export AWS_SECRET_ACCESS_KEY=""
export AWS_SESSION_TOKEN=""
export USE_BEDROCK="0"
export BEDROCK_MODEL_ID="us.anthropic.claude-3-5-sonnet-20241022-v2:0"
# URL_PREFIX="/proxy/8099"  # set when served behind the workshop path proxy

# Real API mode (docs/REAL-API.md): the real FEX agent through the Fair Exchange chat API.
# Local chain (bash scripts/e2e/run_local.sh --web): http://127.0.0.1:3000. Deployed: the FairExchange ApiUrl output.
export FEX_API_URL=""
export FEX_DEMO_PASSCODE=""   # deployed API only
export DATA_SOURCE="mock"     # mock | live: what a new session starts with
