{"version":166,"schema_version":1,"doc":{"type":"doc","attrs":{"table_of_contents":{"enabled":false,"allowedLevels":[1,2,3]}},"content":[{"type":"heading","attrs":{"level":2,"guid":"mvu12wup","collapsedUserIds":[]},"content":[{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"Sample Datasets for Hackathon Build:"}]},{"type":"ordered_list","attrs":{"order":1},"content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"strong"},{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"APS Standard"},{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":" (Excel + PDF) — for grounding the agent’s responses"},{"type":"hard_break","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}]},{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"166 certification clauses, each with an ID, the full objective text, and category. Lets the agent cite a specific standard clause ."}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"strong"},{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"FPS Standard"},{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":" (Excel + PDF) — for grounding factory-type producers"},{"type":"hard_break","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}]},{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"Same purpose as APS, covering Factory-structured accounts (e.g., apparel, furniture) that fall outside the agricultural standard."}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"strong"},{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"Premium Projects (Environmental)"},{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":" — for peer examples"},{"type":"hard_break","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}]},{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"349 real projects from 146 producers (mostly coffee, strong Colombia/Peru/Mexico/Honduras coverage). Gives developers real project narratives to seed a larger synthetic dataset from."}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"strong"},{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"Producers with Linked Project & Survey Data"},{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":" — for deeper per-producer context"},{"type":"hard_break","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}]},{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"A set of 14 producers that have both Premium project records in the environmental category and household survey responses, joined on producer ID, giving developers a case where a producer’s project history and survey context sit together. Survey content is limited to the safe fields only (on-farm environmental practices, water access, self-reported Fair Trade benefits/skills, and farm size), no individual-level, financial, or safeguarding-related fields."}]}]}]},{"type":"paragraph"},{"type":"paragraph"},{"type":"paragraph"},{"type":"heading","attrs":{"level":2,"guid":"mvu1303g","collapsedUserIds":[]},"content":[{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"Notes:"}]},{"type":"bullet_list","content":[{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"349 real projects across 146 producer accounts, clean text (no PII, no coordinates, no named individuals), strong coverage of FTUSA’s core pilot countries (Colombia, Peru, Mexico, Honduras), coffee-dominant with real variety in crops (bananas, cocoa, tea), entity-type signal via "},{"type":"text","marks":[{"type":"code"},{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"structure"},{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":" (1st Grade, Estate, Independent Smallholder, 2nd Grade, Factory, etc.), and a "},{"type":"text","marks":[{"type":"code"},{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"product_category_name"},{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":" field granular enough for real crop-level matching."}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"Only 14 of the 146 producer accounts have linked survey data - survey data is sampled, most producers won’t have any linked survey responses. Build the Producer-record tool to work fully without it, treat survey context as optional enrichment when available, not a dependency."}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"Survey data has been trimmed to the safe fields only: on-farm environmental practices, water access, self-reported Fair Trade benefits/skills, and farm size. No demographics, financial, labor-rights, harassment/discrimination, or food-insecurity fields are included."}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"Survey data is row-level (one row per response), not aggregated."}]}]},{"type":"list_item","content":[{"type":"paragraph","content":[{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"On IDs: "},{"type":"text","marks":[{"type":"code"},{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":"account_sk"},{"type":"text","marks":[{"type":"author_id","attrs":{"authorId":"17193343931"}}],"text":" has been re-keyed before sharing."}]}]}]},{"type":"paragraph"}]},"savepoint_metadata":{"savepointFileId":"2550828383758","savepointsInfo":{"36":{"timestamp":1793039293726,"type":"session","authorsSinceLastSavepoint":["17193343931"]},"127":{"timestamp":1793121756675,"type":"session","authorsSinceLastSavepoint":["17193343931"]},"158":{"timestamp":1793307667622,"type":"session","authorsSinceLastSavepoint":["17193343931"]}},"shouldCreateSavepointBeforeApplyingNextVersion":false,"authorsSinceLastSavepoint":{"17193343931":true},"allAuthorNames":{"17193343931":"Olena Gomozova"}},"last_edit_timestamp":1793308347812}