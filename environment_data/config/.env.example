# Credentials for the gated data sources. Copy this file to config/.env and
# fill in the values. Never commit the real config/.env.
#
# The no-auth sources (CHIRPS, SoilGrids, Aqueduct, LandMark) need nothing here.

# --- ERA5 (Copernicus Climate Data Store) ---------------------------------
# 1. Create a free account:  https://cds.climate.copernicus.eu
# 2. Accept the ERA5 licence on the dataset page (one-time).
# 3. Paste your key from your CDS profile below.
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=your-cds-api-key-here

# --- WDPA (Protected Planet) ----------------------------------------------
# Request a free Personal API Token: https://api.protectedplanet.net/request
WDPA_TOKEN=your-protected-planet-token-here

# --- JRC TMF (Google Earth Engine) ----------------------------------------
# After `earthengine authenticate`, set your Google Cloud project id here.
EE_PROJECT=your-gcp-project-id
